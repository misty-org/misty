{
  "vite": {
    "package": "vite",
    "config": "vite.config.ts",
    "requires": ["tailwind.config.js"],
    "shortConfig": "-c"
  },
  "vitest": { "package": "vitest", "config": "vitest.config.ts", "shortConfig": "-c" },
  "acceptance": { "package": "vitest", "bin": "vitest", "config": "vitest.acceptance.config.ts", "shortConfig": "-c" },
  "eslint": { "package": "eslint", "config": "eslint.config.js", "shortConfig": "-c" },
  "prettier": { "package": "prettier", "config": "prettier.json", "ignorePath": "prettierignore" },
  "audit-ci": { "package": "audit-ci", "config": "audit-ci.json" },
  "gitleaks": { "executable": "gitleaks", "config": "gitleaks.toml" }
}
