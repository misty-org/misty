        "permissions": ["files"],
        "mcp": "adapter",
        "adapter": "misty/adapter.js"
      },
      "add_copies": [
        {
          "from": "snippets",
          "to": "app/snippets"
        }
      ],
      "strip_top": true,
      "add_files": [
        {
          "path": "misty/adapter.js",
          "content": "// WordCraft's tools for agents in Misty, over the page command API every Craft web build puts on\n// `window.wordcraft` (storytold/craft-libs `crates/web-api`): the same commands the app's desktop control\n// server and its own MCP server run (`docs/control-protocol.md`, `docs/mcp.md`). Misty loads this script into\n// the running app and offers these tools as the app's own; it changes nothing about the app.\n(function () {\n  \"use strict\";\n  var APP = \"wordcraft\";\n\n  function api() {\n    var page = window[APP];\n    if (!page || typeof page.request !== \"function\") throw new Error(\"WordCraft is still starting. Try again in a moment.\");\n    return page;\n  }\n\n  function object(value) {\n    return value && typeof value === \"object\" && !Array.isArray(value) ? value : {};\n  }\n\n  var tools = [\n    {\n      name: \"commands\",\n      description: \"List WordCraft's commands: each one's id, label, where it is in the app, its shortcut, the params it takes and whether it is enabled now. Pass search to narrow the list (such as \\\"table\\\" or \\\"style\\\"). Run one with execute.\",\n      inputSchema: {\n        type: \"object\",\n        properties: { search: { type: \"string\", description: \"Words to narrow the list by.\" } },\n        additionalProperties: false,\n      },\n      annotations: { readOnlyHint: true },\n    },\n    {\n      name: \"execute\",\n      description: \"Run one of WordCraft's commands in the open document, as its menus and ribbon do: an id from commands (such as text.insert with {\\\"text\\\": \\\"Hello\\\"}) and its params. Read the document with inspect_document before and after a change.\",\n      inputSchema: {\n        type: \"object\",\n        properties: {\n          command: { type: \"string\", description: \"The command's id, from commands.\" },\n          params: { type: \"object\", description: \"The command's params, as commands lists them.\" },\n          doc: { type: \"number\", description: \"Which open document, from inspect_ui's documents; the active one when left out.\" },\n        },\n        required: [\"command\"],\n        additionalProperties: false,\n      },\n      annotations: { readOnlyHint: false },\n    },\n    {\n      name: \"inspect_document\",\n      description: \"Read the open document: its blocks (text, style, runs, lists and tables), parts, sections, the selection and its pages. Pass text to look for the blocks holding it.\",\n      inputSchema: {\n        type: \"object\",\n        properties: {\n          text: { type: \"string\", description: \"Text to find in the document.\" },\n          doc: { type: \"number\", description: \"Which open document; the active one when left out.\" },\n        },\n        additionalProperties: false,\n      },\n      annotations: { readOnlyHint: true },\n    },\n    {\n      name: \"inspect_ui\",\n      description: \"Read WordCraft's own state: the open view and dialog, the caret, the window's size, where the pages are on screen, and the open documents with their ids, titles and whether they have unsaved changes.\",\n      inputSchema: { type: \"object\", properties: {}, additionalProperties: false },\n      annotations: { readOnlyHint: true },\n    },\n  ];\n\n  function call(name, args) {\n    var input = object(args);\n    var page = api();\n    switch (name) {\n      case \"commands\":\n        return page.request(\"engine.commands\", typeof input.search === \"string\" && input.search ? { search: input.search } : {});\n      case \"execute\": {\n        if (typeof input.command !== \"string\" || !input.command) throw new Error(\"Name the command to run, from commands.\");\n        var params = { command: input.command, params: object(input.params) };\n        if (typeof input.doc === \"number\") params.doc = input.doc;\n        return page.request(\"engine.execute\", params);\n      }\n      case \"inspect_document\": {\n        var query = {};\n        if (typeof input.text === \"string\" && input.text) query.text = input.text;\n        if (typeof input.doc === \"number\") query.doc = input.doc;\n        return page.request(\"document.inspect\", query);\n      }\n      case \"inspect_ui\":\n        return page.request(\"ui.inspect\", {});\n      default:\n        throw new Error(\"WordCraft has no tool called \" + name + \".\");\n    }\n  }\n\n  window.mistyAdapter = { tools: tools, call: call };\n})();\n"
        }
      ]
    }
  ]
}
