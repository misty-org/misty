{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \".agents/skills/impeccable/cli/tasks/hook.ts\" ] || node \".agents/skills/impeccable/cli/tasks/hook.ts\"",
            "timeout": 5,
            "statusMessage": "Checking UI changes",
            "commandWindows": "if exist \".agents/skills/impeccable/cli/tasks/hook.ts\" (node \".agents/skills/impeccable/cli/tasks/hook.ts\" & exit /b)"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \".agents/skills/impeccable/cli/tasks/hook.ts\" ] || node \".agents/skills/impeccable/cli/tasks/hook.ts\"",
            "timeout": 30,
            "statusMessage": "Design deep pass",
            "commandWindows": "if exist \".agents/skills/impeccable/cli/tasks/hook.ts\" (node \".agents/skills/impeccable/cli/tasks/hook.ts\" & exit /b)"
          }
        ]
      }
    ]
  }
}
