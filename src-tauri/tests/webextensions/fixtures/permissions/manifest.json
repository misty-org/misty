{
  "manifest_version": 2,
  "name": "Misty permissions fixture",
  "version": "1.0",
  "description": "Asks for far more than the probe grants, and tries to use all of it.",
  "browser_specific_settings": { "gecko": { "id": "permissions-fixture@misty.test" } },
  "permissions": [
    "storage",
    "tabs",
    "cookies",
    "history",
    "downloads",
    "bookmarks",
    "browsingData",
    "webNavigation",
    "declarativeNetRequest",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "web_accessible_resources": ["public.html"],
  "content_scripts": [
    { "matches": ["http://127.0.0.1/*", "http://localhost/*"], "js": ["content.js"], "run_at": "document_start" },
    { "matches": ["http://127.0.0.1/*"], "js": ["main-world.js"], "run_at": "document_start", "world": "MAIN" }
  ]
}
