{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "space-personal",
        "create": false,
        "title": "Misty",
        "width": 1280,
        "height": 820,
        "minWidth": 640,
        "minHeight": 420,
        "backgroundThrottling": "disabled",
        "backgroundColor": "#131313",
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "dragDropEnabled": true
      }
    ]
  },
  "bundle": {
    "targets": ["appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
