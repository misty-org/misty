{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "space-personal",
        "create": false,
        "title": "Misty",
        "width": 1280,
        "height": 820,
        "minWidth": 640,
        "minHeight": 420,
        "backgroundThrottling": "disabled",
        "backgroundColor": "#131313",
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "dragDropEnabled": true
      }
    ]
  },
  "bundle": {
    "targets": ["appimage", "deb", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": ["libayatana-appindicator3-1", "librsvg2-2"],
        "recommends": ["libgtk-layer-shell0", "xdg-desktop-portal"]
      },
      "rpm": {
        "compression": {
          "type": "zstd",
          "level": 3
        },
        "depends": ["webkit2gtk4.1", "gtk3", "libappindicator-gtk3", "librsvg2"],
        "recommends": ["gtk-layer-shell", "xdg-desktop-portal"]
      }
    }
  }
}
