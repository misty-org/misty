{
  "identifier": "cursor-companion",
  "description": "Cursor overlays: presentation, and Misty there taking the pointer to be clicked or handed a file",
  "platforms": [
    "macOS",
    "windows"
  ],
  "webviews": [
    "misty-cursor-*"
  ],
  "permissions": [
    "core:event:default",
    "allow-cursor-companion-snapshot",
    "allow-cursor-companion-hit",
    "allow-cursor-companion-ask-open"
  ],
  "$schema": "../../gen/schemas/desktop-schema.json"
}
