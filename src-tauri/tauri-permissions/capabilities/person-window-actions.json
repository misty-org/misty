{
  "$schema": "../../gen/schemas/desktop-schema.json",
  "identifier": "person-window-actions",
  "description": "What a person's own Misty window can do",
  "platforms": [
    "macOS",
    "windows",
    "linux"
  ],
  "webviews": [
    "window-*"
  ],
  "permissions": [
    "keystore:default",
    "action-agent",
    "action-api-cache",
    "action-app",
    "action-auth",
    "action-browser",
    "action-browser-recovery",
    "action-clipboard",
    "action-cursor-companion",
    "action-devices",
    "action-engine-config",
    "action-misty-screen",
    "action-model-keys",
    "action-profile",
    "action-profile-tabs",
    "action-sandbox",
    "action-settings",
    "action-shortcuts",
    "action-voice",
    "action-workspace",
    "action-agent-extras",
    "action-pets"
  ]
}
