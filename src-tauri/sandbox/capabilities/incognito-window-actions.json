{
  "$schema": "../../gen/schemas/desktop-schema.json",
  "identifier": "incognito-window-actions",
  "description": "What an incognito window can do: nothing with account data, sync, history, memory or agents",
  "platforms": [
    "macOS",
    "windows",
    "linux"
  ],
  "webviews": [
    "incognito-*"
  ],
  "permissions": [
    "action-app",
    "action-browser",
    "action-clipboard",
    "action-devices",
    "action-extension-popup",
    "action-profile",
    "action-settings",
    "action-shortcuts"
  ]
}
