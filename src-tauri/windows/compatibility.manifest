<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Declares the Windows versions Misty is built for, so Windows runs it with
     their behavior rather than in a legacy compatibility mode (where, among
     other things, layered child windows are unavailable). Merged into every
     binary by build.rs. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
</assembly>
