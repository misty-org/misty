{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "space-personal",
        "create": false,
        "title": "Misty",
        "visible": false,
        "width": 1280,
        "height": 820,
        "minWidth": 640,
        "minHeight": 420,
        "backgroundThrottling": "disabled",
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": false,
        "backgroundColor": "#131313",
        "shadow": true,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "dragDropEnabled": true
      }
    ]
  },
  "build": {
    "beforeBundleCommand": "node tasks/drive_extension.ts"
  },
  "bundle": {
    "macOS": {
      "entitlements": "target/drive-extension/Misty.entitlements",
      "files": {
        "PlugIns/MistyDrive.appex": "target/drive-extension/MistyDrive.appex"
      }
    }
  }
}
