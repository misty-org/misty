    "dev": "vite --mode desktop --config .config/vite.config.ts",
    "build": "tsc && vite build --mode desktop --config .config/vite.config.ts",
    "preview": "vite preview --mode desktop --config .config/vite.config.ts",
    "tauri": "node tasks/tauri.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --config .config/eslint.config.js",
    "lint:fix": "eslint src --fix --config .config/eslint.config.js",
    "test": "vitest run --config .config/vitest.config.ts",
    "test:scripts": "node --test tasks/*.test.ts",
    "audit:production": "audit-ci --config .config/audit-ci.json",
    "check": "npm run check:format && npm run typecheck && npm run lint && npm run test && npm run test:scripts && npm run audit:production",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" --ignore-path .gitignore",
    "check:format": "prettier --check \"src/**/*.{ts,tsx,css}\" --ignore-path .gitignore",
    "check:desktop-agent": "cargo test --manifest-path src-tauri/Cargo.toml --lib agent_pointer_clicks_types_and_selects_in_textedit -- --ignored --nocapture"
