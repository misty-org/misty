{
  "name": "@misty/app",
  "private": true,
  "version": "0.1.0-beta.1",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:desktop",
    "dev:desktop": "node cli/tasks/run-tool.ts vite --mode desktop",
    "build": "npm run build:desktop",
    "build:desktop": "tsc && node cli/tasks/run-tool.ts vite build --mode desktop",
    "preview": "node cli/tasks/run-tool.ts vite preview --mode desktop",
    "tauri": "node --disable-warning=ExperimentalWarning --experimental-strip-types cli/tasks/tauri.ts",
    "typecheck": "tsc --noEmit",
    "lint": "node cli/tasks/run-tool.ts eslint src",
    "lint:fix": "node cli/tasks/run-tool.ts eslint src --fix",
    "test": "node cli/tasks/run-tool.ts vitest run",
    "test:dev-navigation": "node --test cli/tasks/vite-app-entry.test.ts",
    "audit:production": "node cli/tasks/run-tool.ts audit-ci",
    "check": "npm run check:format && npm run typecheck && npm run lint && npm run test && npm run test:dev-navigation && npm run audit:production",
    "format": "node cli/tasks/run-tool.ts prettier --write \"src/**/*.{ts,tsx,css}\"",
    "check:format": "node cli/tasks/run-tool.ts prettier --check \"src/**/*.{ts,tsx,css}\"",
    "cli": "cargo run --manifest-path cli/Cargo.toml --",
    "test:scripts": "node --test cli/tasks/*.test.ts",
    "acceptance": "MISTY_ACCEPTANCE=1 node cli/tasks/run-tool.ts acceptance run",
    "check:desktop-agent": "node cli/tasks/desktop-agent-check.ts",
    "tool": "node cli/tasks/run-tool.ts",
    "release": "cargo run --manifest-path cli/Cargo.toml -- release",
    "release:keys": "node cli/tasks/release/setup-keys.ts"
  },
