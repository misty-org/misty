#!/bin/sh
# Refuses pushes that would publish history the public repository must not contain. The tests ran
# when each commit was made (pre-commit), so a push runs none of them.
set -eu
root=$(git rev-parse --show-toplevel)
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in 0000000000000000000000000000000000000000) continue ;; esac
  python3 "$root/.githooks/check-public-history.py" "$local_sha" || exit 1
done
