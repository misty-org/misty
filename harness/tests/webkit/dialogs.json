{
  "page": "dialogs.html",
  "run": [
    {"name": "the page reads", "op": "snapshot", "expect": {"ok": true, "tree": "~Remove file"}},
    {"name": "find the buttons", "op": "find", "args": {"query": "Remove file"}, "expect": {"ok": true}},
    {"name": "a delete needs allowConsequential", "op": "steps",
     "input": {"steps": [{"action": "click", "ref": "e1"}]},
     "expect": {"ran": 1, "steps": [{"ok": false, "errorCode": "browser_consequential_requires_approval"}]}},
    {"name": "an unarmed confirm is held open", "op": "steps",
     "input": {"allowConsequential": true, "steps": [{"action": "click", "ref": "e1"}, {"action": "click", "ref": "e2"}]},
     "expect": {"ran": 1, "steps": [{"ok": true, "dialog": {"kind": "confirm", "message": "Delete the file?", "held": true}}], "stopped": "~waiting", "heldDialog": {"kind": "confirm"}}},
    {"name": "other steps wait for it", "op": "steps", "input": {"steps": [{"action": "click", "ref": "e2"}]},
     "expect": {"tool_error": {"code": "browser_dialog_held", "message": "~Delete the file?"}, "dialog": {"kind": "confirm"}}},
    {"name": "the page waits too", "op": "page", "js": "return 1", "expectError": "browser_dialog_held"},
    {"name": "it is answered", "op": "steps", "input": {"steps": [{"action": "dialog", "accept": false}]},
     "expect": {"ran": 1, "completed": 1, "steps": [{"ok": true, "dialog": {"kind": "confirm", "accepted": false}}]}},
    {"name": "the page kept the file", "op": "page", "js": "return document.getElementById('out').textContent", "expect": "kept"},
    {"name": "an armed confirm is accepted and the batch goes on to the next dialog", "op": "steps",
     "input": {"allowConsequential": true, "steps": [{"action": "dialog", "accept": true}, {"action": "click", "ref": "e1"}, {"action": "click", "ref": "e3"}]},
     "expect": {"ran": 3, "steps": [{"ok": true}, {"ok": true, "dialog": {"kind": "confirm", "accepted": true}}, {"ok": true, "dialog": {"kind": "alert", "message": "Saved", "held": true}}], "stopped": "~alert"}},
    {"name": "the alert closes and the next step runs", "op": "steps",
     "input": {"steps": [{"action": "dialog", "accept": true}, {"action": "wait_for", "text": "alerted"}]},
     "expect": {"ran": 2, "steps": [{"ok": true, "dialog": {"kind": "alert"}}, {"ok": true, "index": 2}]}},
    {"name": "the page deleted the file", "op": "page", "js": "return document.getElementById('out').textContent", "expect": "alerted"},
    {"name": "a held prompt is answered with text", "op": "steps",
     "input": {"steps": [{"action": "click", "ref": "e2"}]},
     "expect": {"heldDialog": {"kind": "prompt", "message": "Your name?", "defaultText": "nobody"}}},
    {"name": "the prompt gets its answer", "op": "steps",
     "input": {"steps": [{"action": "dialog", "accept": true, "text": "Grace"}]},
     "expect": {"steps": [{"dialog": {"kind": "prompt", "text": "Grace"}}]}},
    {"name": "the page got that name", "op": "page", "js": "return document.getElementById('out').textContent", "expect": "name:Grace"},
    {"name": "an armed prompt gets its text", "op": "steps",
     "input": {"steps": [{"action": "dialog", "accept": true, "text": "Ada"}, {"action": "click", "ref": "e2"}]},
     "expect": {"ran": 2, "steps": [{"ok": true}, {"dialog": {"kind": "prompt", "text": "Ada"}}]}},
    {"name": "the page got the name", "op": "page", "js": "return document.getElementById('out').textContent", "expect": "name:Ada"},
    {"name": "a click on a file input stops with its ref", "op": "steps",
     "input": {"steps": [{"action": "click", "ref": "e4"}, {"action": "click", "ref": "e1"}]},
     "expect": {"ran": 1, "steps": [{"ok": true, "fileChooser": "e4"}], "stopped": "~file chooser"}},
    {"name": "a button that opens the chooser in script stops too", "op": "steps",
     "input": {"steps": [{"action": "click", "ref": "e5"}]},
     "expect": {"ran": 1, "steps": [{"ok": true, "fileChooser": "e4"}]}},
    {"name": "the chooser takes a file", "op": "perform",
     "args": {"step": {"action": "upload", "ref": "e4"}, "file": {"base64": "aGVsbG8=", "name": "notes.txt", "mimeType": "text/plain", "byteSize": 5}},
     "expect": {"ok": true, "inputSelected": true, "name": "notes.txt"}},
    {"name": "the page saw the file", "op": "page", "js": "return document.getElementById('out').textContent", "expect": "file:notes.txt"},
    {"name": "arming a dialog is no page change", "op": "steps",
     "input": {"steps": [{"action": "dialog", "accept": false}]},
     "expect": {"steps": [{"ok": true, "effect": "no change"}]}},
    {"name": "dialogs pass through once the steps end", "op": "page", "js": "return document.documentElement.hasAttribute('data-misty-acting')", "expect": false}
  ]
}
