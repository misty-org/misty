{
  "page": "storage.html",
  "run": [
    {"name": "the page's own cookie", "op": "storage", "input": {"store": "cookies", "action": "get", "name": "visit"},
     "expect": {"ok": true, "cookies": [{"name": "visit", "value": "1", "domain": "127.0.0.1", "path": "/", "httpOnly": false}]}},
    {"name": "a cookie set for the page", "op": "storage", "input": {"store": "cookies", "action": "set", "name": "token", "value": "abc", "sameSite": "Lax"},
     "expect": {"ok": true, "cookie": {"name": "token", "domain": "127.0.0.1"}}},
    {"name": "the page sees it", "op": "page", "js": "return document.cookie.includes('token=abc')", "expect": true},
    {"name": "an http-only cookie", "op": "storage", "input": {"store": "cookies", "action": "set", "name": "session", "value": "s3", "httpOnly": true, "expires": 4102444800},
     "expect": {"ok": true}},
    {"name": "the page can't read it", "op": "page", "js": "return document.cookie.includes('session=')", "expect": false},
    {"name": "it is listed", "op": "storage", "input": {"store": "cookies", "action": "get", "name": "session"},
     "expect": {"cookies": [{"name": "session", "value": "s3", "httpOnly": true, "expires": "*"}]}},
    {"name": "a cookie deleted", "op": "storage", "input": {"store": "cookies", "action": "delete", "name": "token"},
     "expect": {"ok": true, "removed": 1}},
    {"name": "gone from the page", "op": "page", "js": "return document.cookie.includes('token=')", "expect": false},
    {"name": "a delete needs a name", "op": "storage", "input": {"store": "cookies", "action": "delete"},
     "expect": {"status": "failure", "tool_error": {"code": "browser_storage_invalid"}}},
    {"name": "the page's local storage", "op": "storage", "input": {"store": "local"},
     "expect": {"ok": true, "items": [{"name": "theme", "value": "dark"}]}},
    {"name": "an item set", "op": "storage", "input": {"store": "local", "action": "set", "name": "lang", "value": "fr"}, "expect": {"ok": true}},
    {"name": "the page reads it", "op": "page", "js": "return localStorage.getItem('lang')", "expect": "fr"},
    {"name": "an item read", "op": "storage", "input": {"store": "local", "action": "get", "name": "lang"}, "expect": {"found": true, "value": "fr"}},
    {"name": "an item missing", "op": "storage", "input": {"store": "local", "action": "get", "name": "nope"}, "expect": {"found": false}},
    {"name": "an item deleted", "op": "storage", "input": {"store": "local", "action": "delete", "name": "lang"}, "expect": {"removed": 1}},
    {"name": "session storage", "op": "storage", "input": {"store": "session", "action": "get", "name": "step"}, "expect": {"found": true, "value": "2"}},
    {"name": "session storage cleared", "op": "storage", "input": {"store": "session", "action": "clear"}, "expect": {"ok": true, "removed": 1}},
    {"name": "the page's session is empty", "op": "page", "js": "return sessionStorage.length", "expect": 0},
    {"name": "local storage cleared", "op": "storage", "input": {"store": "local", "action": "clear"}, "expect": {"ok": true}},
    {"name": "cookies cleared", "op": "storage", "input": {"store": "cookies", "action": "clear"}, "expect": {"ok": true}},
    {"name": "no cookies left", "op": "storage", "input": {"store": "cookies"}, "expect": {"cookies": []}},
    {"name": "a wrong store", "op": "storage", "input": {"store": "indexed"}, "expect": {"tool_error": {"code": "browser_storage_invalid"}}}
  ]
}
