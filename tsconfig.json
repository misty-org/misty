        "./node_modules/@tiptap/extension-typography/dist/index.d.ts"
      ],
      "@tiptap/extension-unique-id": ["./node_modules/@tiptap/extension-unique-id/dist/index.d.ts"],
      "@tiptap/markdown": ["./node_modules/@tiptap/markdown/dist/index.d.ts"],
