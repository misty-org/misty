{
  "name": "@misty/sdk",
  "version": "0.1.0",
  "description": "The typed, capability-scoped SDK for Misty Apps",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./yjs": {
      "types": "./dist/yjs.d.ts",
      "import": "./dist/yjs.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@misty/contracts": "0.1.0",
    "y-partyserver": "2.2.0",
    "yjs": "13.6.27"
  }
}
