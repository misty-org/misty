{
  "schema_version": 3,
  "id": "backups",
  "name": "Backups",
  "version": "0.4.0",
  "description": "Create encrypted Restic snapshots in a local folder you choose.",
  "author": "Misty",
  "enabled": true,
  "platforms": ["web"],
  "runtime": { "type": "web", "entry": "web/index.html?plugin=backups" },
  "launcher": {
    "views": ["all"],
    "show_in_launcher": true,
    "requires_selected_file": false,
    "open_mode": "tab"
  },
  "plugin": { "runtime": "web", "entry": "web/index.html?plugin=backups" },
  "panels": [
    {
      "id": "backups.panel",
      "title": "Backups",
      "window_type": "panel",
      "default_width": 720,
      "default_height": 620,
      "entry": "web/index.html?plugin=backups",
      "launcher": { "views": ["all"] }
    }
  ],
  "runtime_capabilities": ["files.read", "files.write", "backups.manage"],
  "tools": []
}
