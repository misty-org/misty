{
  "schema_version": 3,
  "id": "image_optimizer",
  "name": "Image Optimizer",
  "version": "0.4.0",
  "description": "Create smaller copies of JPEG, PNG, and WebP images.",
  "author": "Misty",
  "enabled": true,
  "platforms": ["web"],
  "runtime": {
    "type": "web",
    "entry": "web/index.html?plugin=image_optimizer"
  },
  "launcher": {
    "views": ["Files"],
    "show_in_launcher": true,
    "requires_selected_file": false,
    "open_mode": "tab"
  },
  "plugin": {
    "runtime": "web",
    "entry": "web/index.html?plugin=image_optimizer"
  },
  "runtime_capabilities": ["files.read", "files.write"],
  "panels": [
    {
      "id": "image-optimizer.panel",
      "title": "Image Optimizer",
      "window_type": "panel",
      "default_width": 620,
      "default_height": 600,
      "entry": "web/index.html?plugin=image_optimizer",
      "launcher": {
        "views": ["Files"]
      }
    }
  ],
  "tools": []
}
