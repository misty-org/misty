{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "fill"
        },
        "elementRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "text": {
          "type": "string",
          "maxLength": 65536
        }
      },
      "required": [
        "kind",
        "elementRef",
        "text"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "select"
        },
        "elementRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "values": {
          "minItems": 1,
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1000
          }
        }
      },
      "required": [
        "kind",
        "elementRef",
        "values"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "scroll"
        },
        "elementRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "x": {
          "type": "integer",
          "minimum": -4000,
          "maximum": 4000
        },
        "y": {
          "type": "integer",
          "minimum": -4000,
          "maximum": 4000
        }
      },
      "required": [
        "kind",
        "x",
        "y"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "point"
        },
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "kind",
        "x",
        "y"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "key"
        },
        "elementRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "key": {
          "type": "string",
          "enum": [
            "Enter",
            "Escape",
            "Tab",
            "ArrowUp",
            "ArrowDown",
            "ArrowLeft",
            "ArrowRight",
            "Home",
            "End"
          ]
        }
      },
      "required": [
        "kind",
        "elementRef",
        "key"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "extension"
        },
        "extensionId": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "kind",
        "extensionId"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "native"
        },
        "input": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "click"
                },
                "x": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "y": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "button": {
                  "type": "string",
                  "enum": [
                    "left",
                    "right"
                  ]
                },
                "clickCount": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2
                }
              },
              "required": [
                "kind",
                "x",
                "y"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "drag"
                },
                "fromX": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "fromY": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "toX": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "toY": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "kind",
                "fromX",
                "fromY",
                "toX",
                "toY"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "type"
                },
                "text": {
                  "type": "string",
                  "maxLength": 16000
                }
              },
              "required": [
                "kind",
                "text"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "key"
                },
                "key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16
                },
                "modifiers": {
                  "type": "array",
                  "maxItems": 4,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "enum": [
                      "Shift",
                      "Control",
                      "Alt",
                      "Meta"
                    ]
                  }
                }
              },
              "required": [
                "kind",
                "key"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "scroll"
                },
                "x": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "y": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "deltaX": {
                  "type": "integer",
                  "minimum": -2000,
                  "maximum": 2000
                },
                "deltaY": {
                  "type": "integer",
                  "minimum": -2000,
                  "maximum": 2000
                }
              },
              "required": [
                "kind",
                "x",
                "y",
                "deltaX",
                "deltaY"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "kind",
        "input"
      ],
      "additionalProperties": false
    }
  ]
}
