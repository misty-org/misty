package console

import "net/url"

templ accountsPage(v accountsView) {
	@pageHeader("Accounts", plural(len(v.Accounts), "account", "accounts")+" shown") {
		<form class="search" method="get" action="/accounts" role="search">
			@iconSearch()
			<input type="search" name="q" value={ v.Search } placeholder="name@example.com" aria-label="Search accounts"/>
		</form>
	}
	if v.Err != "" {
		@problem(v.Err)
	}
	<div class="split">
		<div class="table accounts-table">
			<div class="table-head"><span>Email</span><span>Devices</span><span>Status</span></div>
			for _, account := range v.Accounts {
				<a
					class={ "table-row", "row-link", templ.KV("selected", account.ID == v.Selected) }
					href={ templ.SafeURL("/accounts?" + url.Values{"q": {v.Search}, "id": {account.ID}}.Encode()) }
					if account.ID == v.Selected {
						aria-current="true"
					}
				>
					<span class="truncate">{ account.Email }</span>
					<span>{ itoa(account.Devices) }</span>
					<span>
						@stateTag(accountStatus(account))
					</span>
				</a>
			}
			if len(v.Accounts) == 0 && v.Err == "" {
				<div class="table-row"><span class="muted">No accounts match.</span></div>
			}
		</div>
		if v.Detail != nil {
			@accountDetail(*v.Detail)
		}
	</div>
}

templ accountDetail(v accountDetailView) {
	<aside id="account-detail" class="detail">
		if v.Account.ID == "" {
			@problem(v.Err)
		} else {
			<div class="detail-title">{ v.Account.Email }</div>
			<p class="muted">
				{ "@" + v.Account.Username + " · joined " + date(v.Account.CreatedAt) }
				if v.Account.Tier != "" {
					{ " · " + humanize(v.Account.Tier) + " plan" }
				}
				{ " · " + bytesLabel(v.Account.StorageBytes) + " library" }
			</p>
			@flash(v.Flash)
			if v.Err != "" {
				@problem(v.Err)
			}
			@sectionLabel("Devices")
			<ul class="rows compact">
				for _, device := range v.Account.DeviceList {
					<li class="row">
						<span class="row-label">
							@deviceIcon(device.Platform)
							{ device.Name }
						</span>
						<span class="muted">
							if device.Revoked {
								revoked
							} else {
								{ "seen " + ago(device.LastSeen) }
							}
						</span>
					</li>
				}
				if len(v.Account.DeviceList) == 0 {
					@emptyRow("No trusted devices")
				}
			</ul>
			@sectionLabel("Sessions and sync")
			<p class="muted">{ plural(v.Account.Sessions, "active session", "active sessions") + " · " + plural(v.Account.SyncWorkspaces, "synced workspace", "synced workspaces") }</p>
			<div class="actions">
				<button
					class="button"
					hx-post={ v.actionPath("revoke-sessions") }
					hx-target="#account-detail"
					hx-swap="outerHTML"
					hx-confirm={ "Sign " + v.Account.Email + " out on every device?" }
					hx-disabled-elt="this"
				>Revoke sessions</button>
				if v.Config.SelfHosted() && v.Account.SelfHosted {
					if v.Account.Disabled {
						<button class="button" hx-post={ v.actionPath("enable") } hx-target="#account-detail" hx-swap="outerHTML" hx-disabled-elt="this">Enable</button>
					} else {
						<button
							class="button"
							hx-post={ v.actionPath("disable") }
							hx-target="#account-detail"
							hx-swap="outerHTML"
							hx-confirm={ "Disable " + v.Account.Email + "? They'll be signed out everywhere." }
							hx-disabled-elt="this"
						>Disable</button>
					}
				}
			</div>
			if v.Config.SelfHosted() && v.Account.SelfHosted {
				@sectionLabel("Reset password")
				<form class="inline-form" hx-post={ v.actionPath("reset-password") } hx-target="#account-detail" hx-swap="outerHTML">
					<input type="password" name="password" minlength="8" required autocomplete="new-password" aria-label="New password" placeholder="New password"/>
					<button class="button" type="submit">Reset password</button>
				</form>
			}
		}
	</aside>
}

templ deviceIcon(platform string) {
	switch platform {
		case "ios", "android":
			@iconPhone()
		case "macos":
			@iconLaptop()
		default:
			@iconMonitor()
	}
}

templ bootstrapPage(v bootstrapView) {
	@pageHeader("Bootstrap", "Create the first administrator of this self-hosted instance")
	@bootstrapPanel(v)
}

templ bootstrapPanel(v bootstrapView) {
	<section id="bootstrap">
		if v.Err != "" {
			@problem(v.Err)
		}
		if v.Bootstrapped {
			<p class="row-label">
				@iconCheck()
				<span>This instance already has an administrator. Invite people from the desktop app.</span>
			</p>
		} else if v.Token != "" {
			@flash("Bootstrap token issued. It works once and expires in 30 minutes.")
			<pre class="token"><code>{ v.Token }</code></pre>
			@note("Paste it into the desktop app's self-host setup. It won't be shown again.")
		} else {
			<p class="muted">Generate a single-use token, then enter it in the desktop app to create the admin account.</p>
			<div class="actions">
				<button class="button" hx-post="/bootstrap/token" hx-target="#bootstrap" hx-swap="outerHTML" hx-disabled-elt="this">
					@iconKey()
					<span>Generate token</span>
				</button>
			</div>
		}
	</section>
}
